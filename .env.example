# Optional overrides. The CLI reads process variables, not dotenv files.
# Offline demos require no providers, credentials or network services.
JARVIS_DATA_DIR=.jarvis
JARVIS_LOG_LEVEL=INFO
# Optional file override; defaults to $JARVIS_DATA_DIR/journal.sqlite3.
# JARVIS_DATABASE_PATH=/absolute/private/path/journal.sqlite3

# Text chat defaults to a real local model; no cloud backend/fallback is enabled.
# Explicit fake development mode: JARVIS_MODEL_PROVIDER=fake (not AI reasoning).
JARVIS_MODEL_PROVIDER=local
JARVIS_LOCAL_MODEL_ENDPOINT=http://127.0.0.1:11434/v1
JARVIS_LOCAL_MODEL_NAME=qwen2.5:3b
# Optional on servers supporting JSON Schema output (including Ollama):
# JARVIS_LOCAL_MODEL_RESPONSE_FORMAT=json_schema
JARVIS_MODEL_TIMEOUT_SECONDS=60
# Chat uses data_dir/chat/journal.sqlite3; --database explicitly overrides it.
# No API keys belong in chat messages, history or endpoint URLs.
